# =============================================================================
# GROWW INTRADAY AUTOMATION - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-random-secret

# -----------------------------------------------------------------------------
# GROWW BROKER API  (Paper / Backtest only - live trading disabled)
# -----------------------------------------------------------------------------
GROWW_API_KEY=your_groww_api_key_here
GROWW_API_SECRET=your_groww_api_secret_here
GROWW_CLIENT_ID=your_client_id_here
GROWW_API_BASE_URL=https://api.groww.in/v1
GROWW_WS_URL=wss://ws.groww.in/v1

# -----------------------------------------------------------------------------
# DATABASE  (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=groww_intraday
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password_here@localhost:5432/groww_intraday
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:your_db_password_here@localhost:5432/groww_intraday

# -----------------------------------------------------------------------------
# TELEGRAM NOTIFICATIONS
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=false

# -----------------------------------------------------------------------------
# TRADING PARAMETERS
# -----------------------------------------------------------------------------
INITIAL_CAPITAL=10000
MAX_RISK_PER_TRADE_PCT=1.0
MAX_OPEN_POSITIONS=3
CANDLE_INTERVAL=5
EXCHANGE=NSE
SEGMENT=EQ

# -----------------------------------------------------------------------------
# BACKTEST
# -----------------------------------------------------------------------------
BACKTEST_START_DATE=2023-01-01
BACKTEST_END_DATE=2023-12-31
BACKTEST_COMMISSION_PCT=0.03
BACKTEST_SLIPPAGE_PCT=0.01

# -----------------------------------------------------------------------------
# DASHBOARD (Streamlit)
# -----------------------------------------------------------------------------
STREAMLIT_PORT=8501

# -----------------------------------------------------------------------------
# API SERVER (FastAPI)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000